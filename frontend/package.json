  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,css}": "npx prettier --write",
    "*.{js,jsx,ts,tsx}": "eslint --cache --fix"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.(ts|tsx)$": "ts-jest",
      "^.+\\.(js|jsx)$": "babel-jest",
      ".+\\.(css|styl|less|sass|scss|png|jpg|ttf|woff|woff2)$": "jest-transform-stub"
    },
    "setupFilesAfterEnv": [
      "./jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!<react-bootstrap>)/"
    ],
    "moduleNameMapper": {
      "\\.(css|less|scss)$": "jest-css-modules",
      "\\.(png|svg|pdf|jpg|jpeg)$": "<rootDir>/__mocks__/fileMock.js",
      "^multiSelectWithFilter(.*)$": "<rootDir>/__mocks__/multiSelectWithFilter.js",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/bootstrap.{js,ts,tsx}",
      "!src/index.{js,ts,tsx}",
      "!src/jest.config.{js,ts}",
      "!src/setupTests.{js,ts,tsx}",
      "!src/redux/actions/index.{js,ts,tsx}",
      "!src/api/index.{js,ts,tsx}",
      "!src/test/**/*.{js,jsx,ts,tsx}"
    ],
    "testPathIgnorePatterns": [
      "\\\\node_modules\\\\",
      "\\\\coverage\\\\",
      "\\\\swagger\\\\",
      "\\\\dist-server\\\\",
      ".*index\\.test\\.(js|ts|tsx)"
    ],
    "moduleFileExtensions": [
      "js",
      "jsx",
      "ts",
      "tsx",
      "json",
      "node"
    ]
  }
